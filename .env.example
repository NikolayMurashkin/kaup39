DATABASE_URL=postgres://kaup39:kaup39@127.0.0.1:5433/kaup39
PAYLOAD_SECRET=
# Каталог медиатеки от корня репозитория. По умолчанию media — фотографии владельцев; e2e-сервер работает с media-e2e.
# MEDIA_DIR=media
# Только на стенде kaup39.mrshkn.com: закрывает демо от индексации и прячет витрину компонентов (D27).
# SITE_ENV=stand
# Накатывает миграции Payload при старте. Задан в образе стенда; локально не включать — рабочая база создана push.
# MIGRATE_ON_START=true
# Каналы заявки с корпоративов: бот студии и почта hello@mrshkn.com. Не заданы — канал молчит, заявка уходит во второй;
# оба молчат — форма показывает ошибку с телефоном владельцев. Значения — только на стенде.
# TELEGRAM_API_URL=https://api.telegram.org
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# SMTP_URL=
# LEAD_MAIL_TO=hello@mrshkn.com
# LEAD_MAIL_FROM=
# Только для yarn check:cms-glyphs: адрес проверяемого сайта (по умолчанию стенд) и вход в его админку. Значения не коммитить.
# KAUP39_URL=https://kaup39.mrshkn.com
# KAUP39_ADMIN_EMAIL=
# KAUP39_ADMIN_PASSWORD=
