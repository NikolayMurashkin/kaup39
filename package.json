{
  "name": "kaup39",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.4",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.15.0",
    "yarn": "4.9.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:tokens": "node scripts/sync-artboard-tokens.mts",
    "sync:runes": "node scripts/sync-runic-alphabet.mts",
    "subset:fonts": "node scripts/subset-fonts.mts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "import:content": "payload run scripts/import-content.ts",
    "check:cms-glyphs": "payload run scripts/check-cms-glyphs.ts",
    "seed:e2e": "payload run tests/e2e/seed/run.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:stand": "playwright test --config playwright.stand.config.ts",
    "test": "yarn typecheck && yarn lint && yarn format:check && yarn test:unit && yarn test:integration && yarn test:e2e"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "nodemailer": "^10.1.1",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@types/subset-font": "^2",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "fontverter": "^2.0.0",
    "pg": "8.20.0",
    "prettier": "^3.6.0",
    "sass": "^1.93.0",
    "smtp-server": "^3.19.13",
    "subset-font": "^2.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
