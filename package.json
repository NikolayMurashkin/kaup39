{
  "name": "kaup39",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.9.4",
  "engines": {
    "node": "24.x"
  },
  "volta": {
    "node": "24.15.0",
    "yarn": "4.9.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:tokens": "node scripts/sync-artboard-tokens.mts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test": "yarn typecheck && yarn lint && yarn format:check && yarn test:unit && yarn test:e2e",
    "build:lighthouse": "NEXT_DIST_DIR=.next-production NEXT_PUBLIC_SITE_URL=http://localhost:3202 next build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.0",
    "sass": "^1.93.0",
    "sharp": "^0.34.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
